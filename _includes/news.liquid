<!-- Local override of al_folio_core's news.liquid: adds `announcements.visible` (rows shown before scrolling). -->
<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    {% assign news_visible = page.announcements.visible | default: 0 %}
    {% assign use_scroll = false %}
    {% if include.limit and page.announcements.scrollable %}
      {% if news_visible > 0 and news_size > news_visible %}
        {% assign use_scroll = true %}
      {% elsif news_visible == 0 and news_size > 3 %}
        {% assign use_scroll = true %}
      {% endif %}
    {% endif %}
    <div
      class="table-responsive{% if use_scroll %} news-scroll{% endif %}"
      {% if use_scroll %}
        data-visible="{{ news_visible }}"
        style="max-height: {% if news_visible > 0 %}{{ news_visible | times: 3 }}rem{% else %}60vw{% endif %}; overflow-y: auto;"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if use_scroll and news_visible > 0 %}
      <script>
        (function () {
          function fit() {
            document.querySelectorAll('.news-scroll[data-visible]').forEach(function (box) {
              var n = parseInt(box.dataset.visible, 10);
              var rows = box.querySelectorAll('tr');
              if (rows.length <= n) return;
              // Height up to the top of row n+1 = exactly n rows visible.
              box.style.maxHeight = rows[n].offsetTop - rows[0].offsetTop + 'px';
            });
          }
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', fit);
          else fit();
          window.addEventListener('load', fit);
          window.addEventListener('resize', fit);
        })();
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
